---
import Icon from './Icon/Icon.astro'
import type { PostMeta } from '../lib/content'

interface Props {
  post: PostMeta
  delay?: number
  /** 是否显示封面图 */
  showCover?: boolean
}

const { post, delay = 0, showCover = true } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const { id, title, description, date, tags, category, cover } = post

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
})

// 封面地址：cover 可能是 /covers/x.svg 或完整 URL
const coverSrc = cover
  ? /^https?:\/\//.test(cover)
    ? cover
    : `${base}${cover}`
  : undefined
---

<article class:list={['card surface', { 'card--has-cover': showCover && coverSrc }]} style={`animation-delay:${delay}s`}>
  <a href={`${base}/posts/${id}/`} class="card__link">
    {
      showCover && (
        <div class="card__cover" aria-hidden="true">
          {coverSrc ? (
            <img src={coverSrc} alt="" loading="lazy" decoding="async" width="320" height="180" />
          ) : (
            <div class="card__cover-placeholder">
              <span>{title.slice(0, 1)}</span>
            </div>
          )}
        </div>
      )
    }

    <div class="card__main">
      {
        (category || post.pinned) && (
          <div class="card__badges">
            {category && (
              <span class="card__category">
                <Icon name="folder" size="0.75em" />
                {category}
              </span>
            )}
            {post.pinned && <span class="card__pin">置顶</span>}
          </div>
        )
      }

      <h3 class="card__title">{title}</h3>

      {description && <p class="card__desc">{description}</p>}

      <div class="card__meta">
        <span class="card__date">
          <Icon name="calendar" size="0.72em" />
          {dateStr}
        </span>
        {
          tags.length > 0 && (
            <span class="card__tags">
              {tags.map((tag) => (
                <span class="card__tag">#{tag}</span>
              ))}
            </span>
          )
        }
      </div>
    </div>

    <span class="card__arrow">
      <Icon name="arrow-right" size="0.85em" />
    </span>
  </a>
</article>

<style>
  .card {
    animation: bottom-to-up 0.55s var(--ease-spring) both;
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
    overflow: hidden;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--primary-glow);
  }

  .card__link {
    display: flex;
    align-items: stretch;
    gap: 1.15rem;
    padding: 1rem;
    color: var(--text);
  }

  .card__link:hover {
    opacity: 1;
  }

  /* ---------- 封面 ---------- */
  .card__cover {
    flex-shrink: 0;
    width: 208px;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: var(--gray-6);
    align-self: center;
    position: relative;
  }

  .card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .card:hover .card__cover img {
    transform: scale(1.05);
  }

  /* 无封面图时的占位块 */
  .card__cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.55), transparent 60%),
      linear-gradient(135deg, var(--primary-soft), rgba(247, 191, 214, 0.35));
  }

  .card__cover-placeholder span {
    font-family: var(--serif-font);
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-ink);
    opacity: 0.55;
  }

  /* ---------- 文字区 ---------- */
  .card__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 0.25rem;
  }

  .card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .card__category,
  .card__pin {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: var(--primary-soft);
    color: var(--primary-ink);
  }

  .card__pin {
    background: rgba(255, 193, 7, 0.15);
    color: #a47600;
  }

  :global(html.dark) .card__pin {
    color: var(--yellow);
  }

  .card__title {
    font-size: 1.08rem;
    margin: 0 0 0.35rem;
    line-height: 1.5;
    transition: color 0.25s var(--ease-out);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card:hover .card__title {
    color: var(--primary-ink);
  }

  .card__desc {
    font-size: 0.865rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 0.76rem;
    color: var(--text-secondary);
  }

  .card__date {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--mono-font);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card__tag {
    color: var(--text-secondary);
  }

  .card__arrow {
    flex-shrink: 0;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary-ink);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-spring);
  }

  .card:hover .card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 720px) {
    .card__link {
      flex-direction: column;
      padding: 0.85rem;
      gap: 0.85rem;
    }

    .card__cover {
      width: 100%;
      aspect-ratio: 16 / 9;
    }

    .card__arrow {
      display: none;
    }
  }
</style>
