---
import Header from '../components/Header/Header.astro'
import Footer from '../components/Footer/Footer.astro'
import { site } from '../config'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/prose.css'

interface Props {
  title?: string
  description?: string
  ogType?: 'website' | 'article'
  image?: string
}

const {
  title,
  description = site.description,
  ogType = 'website',
  image,
} = Astro.props

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.subtitle}`
const canonical = new URL(Astro.url.pathname, Astro.site)

// BASE_URL 在 base:"/xilan" 下是 "/xilan"，不带尾斜杠，
// 统一用这个 helper 拼接，避免出现 /xilanfavicon.svg 这种错误路径。
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '')
const url = (path: string) => `${BASE}/${path.replace(/^\//, '')}`

// 背景图，可通过 public/assets 下的文件替换
const bgLight = url('assets/background.svg')
const bgDark = url('assets/background-night.svg')
---

<!doctype html>
<html lang={site.lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site.title} href={url('feed.xml')} />

    <!-- 防闪烁：在样式加载前确定主题 -->
    <script is:inline define:vars={{ BASE }}>
      // 暴露站点 base，供客户端脚本拼路径
      window.__XILAN_BASE__ = BASE
      document.documentElement.classList.remove('no-js')
      try {
        const stored = localStorage.getItem('xilan-theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const isDark = stored ? stored === 'dark' : prefersDark
        document.documentElement.classList.toggle('dark', isDark)
      } catch (e) {}
    </script>

    <style is:inline define:vars={{ bgLight, bgDark }}>
      :root {
        --bg-light: url('{bgLight}');
        --bg-dark: url('{bgDark}');
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // 主题切换
      const toggle = document.getElementById('theme-toggle')
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark')
        try {
          localStorage.setItem('xilan-theme', isDark ? 'dark' : 'light')
        } catch (e) {}
      })

      // 移动端菜单
      const menuToggle = document.getElementById('menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')
      menuToggle?.addEventListener('click', () => {
        const expanded = menuToggle.getAttribute('aria-expanded') === 'true'
        menuToggle.setAttribute('aria-expanded', String(!expanded))
        if (mobileMenu) mobileMenu.hidden = expanded
      })

      // 滚动时给页头加阴影
      const header = document.getElementById('site-header')
      const onScroll = () => {
        if (!header) return
        header.style.boxShadow = window.scrollY > 8 ? '0 2px 16px rgba(0,0,0,0.06)' : 'none'
      }
      window.addEventListener('scroll', onScroll, { passive: true })
      onScroll()

      /* ---------------- 页头快速搜索 ---------------- */
      const quickForm = document.getElementById('quick-search')
      const quickToggle = document.getElementById('quick-search-toggle')
      const quickInput = document.getElementById('quick-search-input')

      if (quickForm && quickToggle && quickInput) {
        const openSearch = () => {
          quickForm.classList.add('is-open')
          quickToggle.setAttribute('aria-expanded', 'true')
          quickInput.tabIndex = 0
          quickInput.focus()
        }

        const closeSearch = () => {
          quickForm.classList.remove('is-open')
          quickToggle.setAttribute('aria-expanded', 'false')
          quickInput.value = ''
          quickInput.tabIndex = -1
        }

        quickToggle.addEventListener('click', () => {
          if (quickForm.classList.contains('is-open')) closeSearch()
          else openSearch()
        })

        // 点「搜索」或按回车：有内容才跳转
        quickForm.addEventListener('submit', (e) => {
          const q = quickInput.value.trim()
          if (!q) {
            e.preventDefault()
            quickInput.focus()
            return
          }
          // 表单 GET 会把 q 带到 /search?q=...，无需额外处理
        })

        // Esc 收起；点击外部也收起
        quickInput.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            e.preventDefault()
            closeSearch()
          }
        })

        document.addEventListener('click', (e) => {
          if (!quickForm.classList.contains('is-open')) return
          if (!quickForm.contains(e.target)) {
            // 只有输入框为空时才收起，避免误触丢失输入
            if (!quickInput.value.trim()) closeSearch()
          }
        })

        // 按 "/" 直接展开搜索
        document.addEventListener('keydown', (e) => {
          const tag = (document.activeElement?.tagName || '').toLowerCase()
          if (e.key === '/' && tag !== 'input' && tag !== 'textarea') {
            e.preventDefault()
            openSearch()
          }
        })

        // 如果已经在搜索页，带出当前关键词
        if (location.pathname.replace(/\/$/, '').endsWith('/search')) {
          const q = new URLSearchParams(location.search).get('q')
          if (q) {
            quickForm.classList.add('is-open')
            quickToggle.setAttribute('aria-expanded', 'true')
            quickInput.value = q
          }
        }
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 999;
    padding: 0.75rem 1.25rem;
    background: var(--primary);
    color: #fff;
    border-radius: 0 0 8px 0;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
